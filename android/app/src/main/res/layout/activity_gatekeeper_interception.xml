<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gatekeeper_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131312"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="20dp"
    android:paddingRight="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gk_eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="LOBOTOMI · GATEKEEPER"
            android:textAllCaps="true"
            android:textColor="#969185"
            android:textSize="11sp" />

        <Button
            android:id="@+id/gk_mute_btn"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_gatekeeper_card"
            android:fontFamily="monospace"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:stateListAnimator="@null"
            android:text="MUTE"
            android:textAllCaps="true"
            android:textColor="#E6E2D8"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gk_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.08"
        android:text="Pause before App"
        android:textColor="#E6E2D8"
        android:textSize="30sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <com.lobotomi.app.BreathRingView
            android:id="@+id/gk_breath_ring"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gk_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="03:00"
                android:textColor="#E6E2D8"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/gk_breath_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="Inhale steadily"
                android:textColor="#969185"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_gatekeeper_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/gk_prompt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="OBSERVATION"
            android:textAllCaps="true"
            android:textColor="#7A9E84"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/gk_prompt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.35"
            android:textColor="#E6E2D8"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/gk_slow_btn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_gatekeeper_btn_primary"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:text="Put It Down &amp; Do Something Slow"
        android:textAllCaps="false"
        android:textColor="#131312"
        android:textSize="14sp" />

    <Button
        android:id="@+id/gk_continue_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gatekeeper_btn_secondary"
        android:enabled="false"
        android:fontFamily="sans-serif"
        android:stateListAnimator="@null"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="#5E5B52"
        android:textSize="13sp" />

</LinearLayout>
